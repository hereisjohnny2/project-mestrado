# Copie para .env.prod NO SERVIDOR (chmod 600). Nunca versione o .env.prod.

# Domínio do serviço (registro A no DNS apontando para o IP da VPS; o proxy compartilhado,
# deploy/edge/ no repositório honda-rag, precisa da mesma variável em deploy/edge/.env.edge)
ROCKSEG_DOMAIN=rockseg.seudominio.com

# Assina os tokens de sessão — troque por um valor longo e aleatório fora do uso local
ROCKSEG_SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
