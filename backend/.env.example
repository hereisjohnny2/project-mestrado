# Copy to .env for local overrides (docker-compose sets its own env vars).
ROCKSEG_STORAGE_DIR=./storage
ROCKSEG_DATABASE_URL=sqlite:///./storage/db.sqlite3
ROCKSEG_CORS_ORIGINS=["http://localhost:5173"]
# Signs session tokens — set to a long random value outside local dev.
ROCKSEG_SECRET_KEY=change-me
# Set to true when served over HTTPS.
ROCKSEG_COOKIE_SECURE=false
